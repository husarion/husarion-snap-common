<?xml version="1.0" encoding="UTF-8"?>
<!-- Robot world: SHM + UDP on 127.0.0.1 only. NO_FILTER is required: with FILTER_DIFFERENT_HOST processes whose host ids differ never match. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>robot_world_udp_lo</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
      <maxInitialPeersRange>64</maxInitialPeersRange>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>robot_world_shm</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
      <maxMessageSize>4194304</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="robot_world" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>robot_world_shm</transport_id>
        <transport_id>robot_world_udp_lo</transport_id>
      </userTransports>
      <builtin>
        <discovery_config>
          <ignoreParticipantFlags>NO_FILTER</ignoreParticipantFlags>
        </discovery_config>
        <metatrafficUnicastLocatorList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
      <allocation>
        <total_participants>
          <initial>32</initial>
          <maximum>0</maximum>
        </total_participants>
        <total_readers>
          <initial>256</initial>
          <maximum>0</maximum>
        </total_readers>
        <total_writers>
          <initial>256</initial>
          <maximum>0</maximum>
        </total_writers>
      </allocation>
    </rtps>
  </participant>
</profiles>
